  "questions": [
   {
    "type": "MCQ",
    "text": "Which graph representation always uses O(V^2) memory, however few edges there are?",
    "options": [
     "Adjacency list",
     "Edge list",
     "Adjacency matrix",
     "A list of neighbour sets"
    ],
    "answer": "Adjacency matrix",
    "explanation": "A matrix stores one cell per vertex pair. An adjacency list stores only the edges that exist, O(V + E).",
    "points": 10
   },
   {
    "type": "PREDICT_OUTPUT",
    "text": "What does this program print?",
    "code": "import java.util.*;\n\npublic class Main {\n    public static void main(String[] args) {\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < 4; i++) adj.add(new ArrayList<>());\n        int[][] e = {{0, 1}, {1, 2}, {1, 3}};\n        for (int[] x : e) {\n            adj.get(x[0]).add(x[1]);\n            adj.get(x[1]).add(x[0]);\n        }\n        System.out.println(adj.get(1));\n    }\n}\n",
    "options": [
     "[0, 2, 3]",
     "[2, 3]",
     "[1, 2, 3]",
     "[0, 1, 2, 3]"
    ],
    "answer": "[0, 2, 3]",
    "explanation": "The graph is undirected, so edge {0,1} also adds 0 to vertex 1's list, followed by neighbours 2 and 3. Printing [2, 3] forgets the reverse direction of the first edge.",
    "points": 10
   },
   {
    "type": "CHOOSE_APPROACH",
    "text": "A road network has 100000 junctions and about 200000 roads. You must list the neighbours of a junction quickly. Which representation fits?",
    "options": [
     "An adjacency matrix of 100000 x 100000 booleans",
     "A list of all roads scanned for every query",
     "A 2D array of junction coordinates",
     "An adjacency list"
    ],
    "answer": "An adjacency list",
    "explanation": "The graph is sparse, so a list uses about 400000 entries (2 per road). A matrix needs 10^10 cells, far too much memory, and scanning every road is O(E) per query.",
    "points": 15
   },
   {
    "type": "MCQ",
    "text": "An undirected graph with E edges is stored as an adjacency list. How many entries are there in total across all lists?",
    "options": [
     "2E, because each edge appears in both endpoints' lists",
     "E, one per edge",
     "E / 2, because edges are shared",
     "V, one per vertex"
    ],
    "answer": "2E, because each edge appears in both endpoints' lists",
    "explanation": "Edge {u,v} is stored once under u and once under v. In a directed graph the total would be E.",
    "points": 15
   },
