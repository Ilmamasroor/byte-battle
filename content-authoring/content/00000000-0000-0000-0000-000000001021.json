   "title": "Sorted Neighbour Lists",
   "description": "Build an adjacency list for an undirected graph with n vertices numbered 0 to n-1. For each vertex from 0 to n-1 print the vertex, a colon, and then its neighbours in increasing order, each preceded by a space. A vertex with no neighbours prints just the colon. There are no self loops and no repeated edges.",
   "difficulty": "MEDIUM",
   "inputDescription": "Line 1: n and m. Then m lines, each with two vertices u v (an undirected edge).",
   "outputDescription": "n lines in the form 'v: a b c'.",
   "constraints": "1 <= n <= 1000, 0 <= m <= 5000",
   "starterCode": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        StreamTokenizer st = new StreamTokenizer(new BufferedInputStream(System.in));\n        st.nextToken(); int n = (int) st.nval;\n        st.nextToken(); int m = (int) st.nval;\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        for (int i = 0; i < m; i++) {\n            st.nextToken(); int u = (int) st.nval;\n            st.nextToken(); int v = (int) st.nval;\n            // TODO: record the undirected edge in both lists\n        }\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < n; i++) {\n            // TODO: sort the neighbours before printing\n            sb.append(i).append(\":\");\n            for (int v : adj.get(i)) sb.append(' ').append(v);\n            sb.append('\\n');\n        }\n        System.out.print(sb);\n    }\n}\n",
   "solutionCode": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        StreamTokenizer st = new StreamTokenizer(new BufferedInputStream(System.in));\n        st.nextToken(); int n = (int) st.nval;\n        st.nextToken(); int m = (int) st.nval;\n        List<List<Integer>> adj = new ArrayList<>();\n        for (int i = 0; i < n; i++) adj.add(new ArrayList<>());\n        for (int i = 0; i < m; i++) {\n            st.nextToken(); int u = (int) st.nval;\n            st.nextToken(); int v = (int) st.nval;\n            adj.get(u).add(v);\n            adj.get(v).add(u);\n        }\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < n; i++) {\n            Collections.sort(adj.get(i));\n            sb.append(i).append(\":\");\n            for (int v : adj.get(i)) sb.append(' ').append(v);\n            sb.append('\\n');\n        }\n        System.out.print(sb);\n    }\n}\n",
