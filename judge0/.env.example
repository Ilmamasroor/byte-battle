# Copy to .env (git-ignored) and fill in strong random values. Names only here; never commit real values.
JUDGE0_DB_PASSWORD=
JUDGE0_REDIS_PASSWORD=
# Must equal JUDGE0_AUTH_TOKEN of the Spring backend (sent as the X-Auth-Token header).
JUDGE0_AUTHN_TOKEN=
JUDGE0_SECRET_KEY_BASE=
# Optional: CPU / memory for the Judge0 workers (default 4.0 / 4g). Compiles run in parallel, so more is faster.
# JUDGE0_WORKER_CPUS=4.0
# JUDGE0_WORKER_MEMORY=4g
