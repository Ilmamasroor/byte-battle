# Groq API key (https://console.groq.com/keys). If unset the service still starts;
# LLM endpoints answer 503 AI_NOT_CONFIGURED and /health reports llmConfigured=false.
GROQ_API_KEY=

# Groq model id (default: openai/gpt-oss-120b)
GROQ_MODEL=

# Per-request timeout in seconds (default: 4)
GROQ_TIMEOUT_SECONDS=

# Provider retry count (default: 1)
GROQ_MAX_RETRIES=

# Byte DNA dimension update: updated = previous * W + new * (1 - W). Default W: 0.7
BYTE_DNA_WEIGHT_PREVIOUS=
