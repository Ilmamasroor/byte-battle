{
 "conceptId": "00000000-0000-0000-0000-000000001024",
 "title": "Memoization: never solve the same subproblem twice",
 "kind": "structure",
 "intro": "Plain recursive fib(5) repeats itself a lot. Watch the waste, then watch a memo remove it.",
 "predict": {
  "question": "In the plain fib(5) call tree (15 calls), how many times is fib(2) computed?",
  "options": [
   "1",
   "2",
   "3"
  ],
  "answer": 2,
  "reveal": "fib(2) is called three times: under fib(4) and under both copies of fib(3). Memoization computes it once."
 },
 "takeaway": "Memoization stores each answer in a hash map the first time, so repeated calls return instantly. Exponential work becomes linear.",
 "code": [
  "int fib(int n) {",
  "  if (n <= 1) return n;",
  "  if (memo.has(n)) return memo[n];",
  "  int r = fib(n - 1) + fib(n - 2);",
  "  memo[n] = r; return r;",
  "}"
 ],
