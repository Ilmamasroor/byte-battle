 "title": "Monotonic stack: next greater element",
 "kind": "structure",
 "intro": "For each number, which is the first bigger number to its right? A stack finds all of them in one pass.",
 "predict": {
  "question": "In [2, 1, 5, 3, 4], what is the next greater element of 3?",
  "options": [
   "5",
   "4",
   "-1 (none)"
  ],
  "answer": 1,
  "reveal": "Right of 3 is only 4, and 4 > 3, so the answer is 4. The stack finds it when 4 arrives and pops 3."
 },
 "takeaway": "Keep a stack of values still waiting for a bigger one. A bigger arrival pops and answers them, so every item is pushed and popped once.",
 "code": [
  "for i in 0..n-1:",
  "  while st and a[st.top] < a[i]:",
  "    ans[st.pop()] = a[i]",
  "  st.push(i)",
  "leftover in st -> ans = -1"
