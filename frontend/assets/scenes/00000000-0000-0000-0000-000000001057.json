 "kind": "structure",
 "intro": "We want the best 3 neighbours in a row. Instead of re-adding every time, we will slide a window along the array.",
 "predict": {
  "question": "When a window of 3 slides one place, how many numbers must you add or subtract to update its sum?",
  "options": [
   "3",
   "2",
   "1"
  ],
  "answer": 1,
  "reveal": "2. Add the new element entering on the right and subtract the old one leaving on the left. The rest are unchanged."
 },
 "takeaway": "Reuse the previous window's sum: add the element entering, subtract the one leaving, and the whole scan is O(n).",
 "code": [
  "int sum = a[0] + a[1] + a[2], best = sum;",
  "for (int i = 3; i < n; i++) {",
  "  sum += a[i];",
  "  sum -= a[i - 3];",
  "  best = max(best, sum);",
  "}"
