 "title": "Graph representation: list or matrix",
 "kind": "structure",
 "intro": "One small graph, three ways to see it: a drawing, an adjacency list, and an adjacency matrix.",
 "predict": {
  "question": "Which representation lists a node's neighbors without scanning a whole row of n cells?",
  "options": [
   "Adjacency list",
   "Adjacency matrix",
   "Both the same"
  ],
  "answer": 0,
  "reveal": "A list stores only real neighbors. A matrix row has n cells, mostly 0 in a sparse graph, so you scan them all."
 },
