{
 "conceptId": "00000000-0000-0000-0000-000000001058",
 "title": "Backtracking: choose, explore, un-choose",
 "kind": "structure",
 "intro": "Recursion can try every option, taking one back when it is done. Watch it list every subset of A, B, C.",
 "predict": {
  "question": "How many subsets does a 3-item set have, counting the empty one?",
  "options": [
   "6",
   "8",
   "9"
  ],
  "answer": 1,
  "reveal": "8. Each item is either taken or skipped, so there are 2 x 2 x 2 = 8 choices, one leaf in the tree for each."
 },
 "takeaway": "Backtracking: choose an option, explore deeper, then un-choose it so the next option starts from a clean path.",
 "code": [
  "void go(int i) {",
  "  if (i == n) { print(path); return; }",
  "  path.add(a[i]);       // choose",
  "  go(i + 1);            // explore",
  "  path.removeLast();    // un-choose",
  "  go(i + 1);            // skip a[i]",
  "}"
 ],
