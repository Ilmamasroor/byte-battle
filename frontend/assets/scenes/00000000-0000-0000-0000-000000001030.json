{
 "conceptId": "00000000-0000-0000-0000-000000001030",
 "title": "Keys and constraints: the database says no",
 "kind": "table",
 "intro": "Constraints are rules the database enforces for you. Let's try to break them and see what happens.",
 "predict": {
  "question": "We INSERT an order with user_id 9, but no user 9 exists. What happens?",
  "options": [
   "It is inserted with user_id 9",
   "It is inserted with user_id NULL",
   "The database rejects it"
  ],
  "answer": 2,
  "reveal": "A FOREIGN KEY must point at a real row. user 9 does not exist, so the INSERT fails with an error and nothing is saved."
 },
 "takeaway": "PRIMARY KEY and UNIQUE stop duplicates, NOT NULL stops blanks, FOREIGN KEY stops links to rows that do not exist.",
