  "Thread t = new Thread(() -> hi());",
  "t.run();    // oops: plain method call",
  "t.start();  // real new thread",
  "t.join();   // main waits for t",
  "System.out.println(\"main done\");",
  "// hi() prints \"hi from \" + thread name"
 ],
