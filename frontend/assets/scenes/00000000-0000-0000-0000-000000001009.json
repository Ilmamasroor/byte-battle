  "reveal": "Each item is compared once with its left neighbour, finds it is not smaller, and stays. That is about n comparisons and zero swaps."
 },
 "takeaway": "Insertion sort grows a sorted section by sliding each item into place: fast on nearly sorted data, O(n^2) in general.",
 "code": [
  "for (int i = 1; i < n; i++) {",
  "  for (int j = i; j > 0 && a[j-1] > a[j]; j--)",
  "    swap(a, j, j - 1);",
  "}"
