{
 "conceptId": "00000000-0000-0000-0000-000000001014",
 "title": "Locks: lock(), unlock() and tryLock()",
 "kind": "computer",
 "intro": "A ReentrantLock is a lock you control yourself. You must unlock it, and tryLock lets a thread give up. Let's watch both.",
 "predict": {
  "question": "A thread calls lock.lock(), then an exception is thrown before unlock() and there is no finally. What happens to the other threads?",
  "options": [
   "Java frees the lock automatically",
   "They wait forever for a lock nobody releases",
   "Java kills all waiting threads"
  ],
  "answer": 1,
  "reveal": "A ReentrantLock is never released for you. Without unlock() in a finally block, the lock stays owned and everyone else waits forever."
 },
 "takeaway": "Always unlock() in a finally block. Use tryLock with a timeout when you would rather give up than wait forever.",
 "code": [
  "lock.lock();",
  "try {",
  "  counter.value++;",
  "} finally {",
  "  lock.unlock();   // always runs",
  "}",
  "// Thread-2 refuses to wait forever:",
  "if (lock.tryLock(1, SECONDS)) {",
  "  try { counter.value++; }",
  "  finally { lock.unlock(); }",
  "} else { log(\"busy, skipping\"); }"
 ],
