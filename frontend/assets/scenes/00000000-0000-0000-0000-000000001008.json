 "title": "Binary search: halve the problem each time",
 "kind": "structure",
 "intro": "We are hunting for 23 in a sorted list. How many peeks will it take?",
 "predict": {
  "question": "Searching a sorted list of 1,000,000 numbers, about how many items does binary search need to look at?",
  "options": [
   "About 500,000",
   "About 1,000",
   "About 20"
  ],
  "answer": 2,
  "reveal": "Each peek halves what is left: 1,000,000 shrinks to 1 in about 20 halvings. That is O(log n)."
 },
 "takeaway": "On sorted data, one comparison removes half the remaining items, so the work grows like log n.",
 "code": [
  "int lo = 0, hi = n - 1;",
  "while (lo <= hi) {",
  "  int mid = (lo + hi) / 2;",
  "  if (a[mid] == t) return mid;",
  "  if (a[mid] < t) lo = mid + 1;",
  "  else hi = mid - 1;",
  "}"
 ],
